# Config directory: ignore everything by default, whitelist only sample configs.
config/*
!config/mcp_universal.json
!config/claude_desktop_config.json
!config/cline_mcp_settings.json
!config/.env.example

# Secrets
.env
.env.local

# Legacy runtime code & binaries (kept locally, not committed)
mcp_unified/
external/
bin/
archive/

# Symlinks & editor files
mcp_config.json
.agent_identity
.cursor/
.vscode/
.idea/

# Python
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Data & logs (runtime artifacts)
data/
logs/
*.log
*.db
*.sqlite
*.sqlite3

# Node / legacy JS
node_modules/
package-lock.json

# OS
.DS_Store
Thumbs.db

# Temporary / backup
*.bak
*.tmp
*.swp
*~
