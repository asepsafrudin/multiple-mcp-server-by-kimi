# Copy this file to .env and fill in real values.
# NEVER commit .env or config/credentials/ to Git.

# -----------------------------------------------------------------------------
# Core paths
# -----------------------------------------------------------------------------
MCP_ROOT=/home/aseps/MCP
MCP_LOG_LEVEL=INFO
MCP_ALLOWED_DIRECTORIES=/home/aseps/MCP,/home/aseps/Workspace,/tmp
MCP_MAX_FILE_SIZE_MB=10

# -----------------------------------------------------------------------------
# PostgreSQL + pgvector
# -----------------------------------------------------------------------------
DB_URL=postgresql://aseps:your_secure_password@localhost:5432/mcp
DB_POOL_MIN=1
DB_POOL_MAX=10

# -----------------------------------------------------------------------------
# Redis (working memory, cache, checkpoints)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Ollama (local embeddings)
# -----------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSION=768

# Optional fallback / chat model via Ollama
OLLAMA_CHAT_MODEL=llama3.2

# -----------------------------------------------------------------------------
# Rust MCP filesystem bridge
# -----------------------------------------------------------------------------
RUST_FS_BINARY=/home/aseps/MCP/bin/rust-mcp-filesystem

# -----------------------------------------------------------------------------
# Gmail / Google credentials (path to JSON files)
# -----------------------------------------------------------------------------
GMAIL_CREDENTIALS_PATH=/home/aseps/MCP/config/credentials/gmail-client-secret.json
GMAIL_TOKEN_PATH=/home/aseps/MCP/config/credentials/gmail-token.json
GOOGLE_VISION_CREDENTIALS_PATH=/home/aseps/MCP/config/credentials/vision-primary.json

# -----------------------------------------------------------------------------
# Gemini
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_default_chat_id

# -----------------------------------------------------------------------------
# External APIs (fill only what you use)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
HUGGINGFACE_ACCESS_TOKEN=your_hf_token

# -----------------------------------------------------------------------------
# MikroTik RouterOS (REST API + SSH)
# -----------------------------------------------------------------------------
# Dua jalur:
#  - REST API: RouterOS v7 / v6.48.2+ via layanan www-ssl (HTTPS port 443). Butuh
#    sertifikat (self-signed dapat dibuat lewat /certificate di router). Lihat
#    DEPLOYMENT.md -> "Setup MikroTik RouterOS bridge".
#    Opsi HTTP (port 80) juga bisa bila www aktif, tapi kredensial dikirim plaintext.
#  - SSH: layanan ssh + user dengan hak login (group full).
MIKROTIK_HOST=192.168.1.2
MIKROTIK_PORT=443
MIKROTIK_SCHEME=https
MIKROTIK_TLS_VERIFY=false
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your_router_password
MIKROTIK_SSH_PORT=22

# -----------------------------------------------------------------------------
# Workspace knowledge harvesting
# -----------------------------------------------------------------------------
WORKSPACE_ROOT=/home/aseps/Workspace
KNOWLEDGE_MAX_FILES_PER_RUN=200
